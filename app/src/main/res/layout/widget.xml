<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/w_bg" android:padding="12dp">
    <LinearLayout android:id="@+id/head" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingBottom="8dp">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_launcher" android:contentDescription="@null"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="8dp" android:text="USSD Lab" android:textColor="@color/w_text" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_sub" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="44dp" android:orientation="horizontal">
        <TextView android:id="@+id/b1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/w_tile" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="8dp"
            android:textColor="@color/w_on_tile" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end"
            android:drawablePadding="8dp"/>
        <View android:layout_width="8dp" android:layout_height="1dp"/>
        <TextView android:id="@+id/b2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/w_tile" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="8dp"
            android:textColor="@color/w_on_tile" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end"
            android:drawablePadding="8dp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="44dp" android:layout_marginTop="8dp" android:orientation="horizontal">
        <TextView android:id="@+id/b3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/w_tile" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="8dp"
            android:textColor="@color/w_on_tile" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end"
            android:drawablePadding="8dp"/>
        <View android:layout_width="8dp" android:layout_height="1dp"/>
        <TextView android:id="@+id/b4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/w_tile" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="8dp"
            android:textColor="@color/w_on_tile" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end"
            android:drawablePadding="8dp"/>
    </LinearLayout>
    <TextView android:id="@+id/reply" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:background="@drawable/w_reply" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp"
        android:textColor="@color/w_text" android:textSize="13sp" android:maxLines="3" android:ellipsize="end"/>
</LinearLayout>
